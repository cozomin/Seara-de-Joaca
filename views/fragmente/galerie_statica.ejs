<div id="galerie-statica">
    <% if(locals.imagini) { %>
        
        <% for(let img of locals.imagini) { %>
            <figure class="galerie-item">
                <picture>
                    <source srcset="<%= img.fisier_mic %>" media="(max-width: 700px)"/>
                    <source srcset="<%= img.fisier_mediu %>" media="(max-width: 1200px)"/>
                    <img src="<%= img.fisier %>" 
                         alt="<%= img.alt ? img.alt : img.nume %>" 
                         title="<%= img.descriere %>">
                </picture>
                
                <figcaption>
                    <%= img.descriere %>
                    
                    <% if(img.autor && img.licenta) { %>
                        <br><small style="font-size: 0.75rem;">
                            Imagine de 
                            <a href="<%= img.link_autor ? img.link_autor : '#' %>" target="_blank" style="color:var(--culoare_contur, #33C0F5);"><%= img.autor %></a>, 
                            sub <a href="<%= img.link_licenta %>" target="_blank" style="color:var(--culoare_contur, #33C0F5);"><%= img.licenta %></a>.
                        </small>
                    <% } else if(img.licenta) { %>
                        <br><small style="font-size: 0.75rem;">Licență: <%= img.licenta %></small>
                    <% } %>
                </figcaption>
            </figure>
        <% } %>
        
    <% } %>
</div>