<section id="sectiune-galerie-animata">
    <div id="galerie-animata" class="galerie-a">
        <div id="grid-animat">
            <% for (let imag of locals.imaginiGalerieAnimata) { %>
                <figure>
                    <img src="<%- imag.fisier_mediu || imag.fisier %>"
                         alt="<%- imag.alt || imag.nume || 'imagine galerie' %>"
                         title="<%- imag.descriere || imag.nume || '' %>">
                    <figcaption><%- imag.nume || '' %></figcaption>
                </figure>
            <% } %>
        </div>
    </div>
</section>