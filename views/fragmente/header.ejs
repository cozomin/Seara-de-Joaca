<header id="antet">
    <div id="logo">
        <picture id="piclogo">
            <source srcset="/resurse/imagini/logo_200w.png" media="(max-width:700px)"/>
            <source srcset="/resurse/imagini/logo_400w.png" media="(max-width:1200px)"/>
            <img src="/resurse/imagini/logo_800w.png" alt="logo" title="logo Seara de Joacă">
        </picture>
    </div>

    <div id="nume">
        <h1>Seara de Joacă</h1>
    </div>
    
    <div class="d-flex align-items-center form-check form-switch" id = "n-switch">
        <input class="n-check form-check-input" type="checkbox" id="btn-tema">
        <label class="n-form form-check-label ms-1" for="btn-tema">
            <i id="icon-tema" class="fa-solid fa-sun text-warning"></i>
        </label>
    </div>

    <nav>
        <label id="hamburger" for="ch-menu">
            <span class="bar" id="bar-1"></span>
            <span class="bar" id="bar-2"></span>
            <span class="bar" id="bar-3"></span>
        </label>
        <input type="checkbox" id="ch-menu"/>
        
        <ul class="meniu">
            <li>
                <div class="text-icon" id="acasa"><a href="/">Acasă</a></div>
                <div class="imag-icon" id="acasa-mediu">
                    <a class="fas fa-regular fa-house" href="/"></a>
                </div>
                <ul>
                    <li><a href="/#welcome">Bun venit</a></li>
                    <li><a href="/#promotii">Promoții și oferte</a></li>
                    <li><a href="/#anunturi">Anunțuri</a></li>
                    <li><a href="/#resurse-utile">Resurse utile</a></li>
                    <li><a href="/#index-intrebari">Întrebări frecvente</a></li>
                    <li><a href="/#subsol">Contact</a></li>
                </ul>
            </li>
            <li>
                <div class="text-icon" id="despre_noi"><a href="/despre">Despre noi</a></div>
                <div class="imag-icon" id="acasa-mediu">
                    <a class="fa fa-circle-info" href="/despre"></a>
                </div>
            </li>
            <li>
                <div class="text-icon"><a href="/produse">Produse</a></div>
                <div class="imag-icon" ><a class="fas fa-solid fa-dice" href="/produse"></a></div>
                <ul>
                    <li><a href="/produse">Toate produsele</a></li>
                    <% if (locals.optiuni) { %>
                        <% for (let opt of locals.optiuni) { %>
                            <li><a href="/produse?tip=<%- opt.unnest %>"><%- opt.unnest %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>

            <li>
                <div class="text-icon"><a href="cont.ejs">Cont client</a></div>
                <div class="imag-icon"><a class="fa-solid fa-circle-user"></a></div> <ul>
                    <li><a href="cont.ejs#date-personale">Date personale</a></li>
                    <li><a href="cont.ejs#istoric-comenzi">Istoric comenzi</a></li>
                    <li><a href="cont.ejs#wishlist">Wishlist</a></li>
                    <li><a href="cont.ejs#puncte-loialitate">Puncte de loialitate</a></li>
                </ul>
            </li>
        </ul>
    </nav>
</header>