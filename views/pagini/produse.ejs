<!DOCTYPE html>
<html lang="ro">
<head>
    <meta name="description" content="Magazinul Seara de Joacă oferă jocuri de societate, jucării, articole hobby și educative.">
    <meta name="keywords" content="jocuri, boardgames, Seara de Joaca, jucarii copii, educativ">
    <title>Seara de Joacă - Produse</title>
    <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
    <%- include("../fragmente/head") %>     
    <script type="text/javascript" src="/resurse/js/produs.js"></script>
    <script type="text/javascript" src="/resurse/js/comparare.js"></script>
</head>
<body>
    <%- include("../fragmente/header") %>

    <% 
        function formateazaData(dataStr) {
            if(!dataStr) return "";
            let d = new Date(dataStr);
            const luni = ['Ianuarie', 'Februarie', 'Martie', 'Aprilie', 'Mai', 'Iunie', 'Iulie', 'August', 'Septembrie', 'Octombrie', 'Noiembrie', 'Decembrie'];
            const zile = ['Duminică', 'Luni', 'Marți', 'Miercuri', 'Joi', 'Vineri', 'Sâmbătă'];
            return d.getDate() + '-' + luni[d.getMonth()] + '-' + d.getFullYear() + ' (' + zile[d.getDay()] + ')';
        }
    %>

    <main class="container my-5">
        <h2 class="text-primary fw-bold mb-4"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Produse</h2>
        
        <section class="filtru-container container border rounded-3 shadow-sm p-4 mb-5 bg-white">
            <div class="row g-3">

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold text-dark" for="inp-nume"><i class="bi bi-search me-1"></i>Nume produs (fără cifre):</label>
                    <input type="text" id="inp-nume" class="form-control" placeholder="Ex: <%= locals.produsExemplu %>">
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold text-dark mb-1"><i class="bi bi-chat-left-text me-1"></i>Descriere produs:</label>
                    <div class="form-floating">
                        <textarea class="form-control" id="inp-descriere" title="Căutați detalii (ex: <%= locals.produsExemplu %>)" placeholder="Introduceți un cuvânt" style="height: 58px"></textarea>
                        <label for="inp-descriere">Cuvânt cheie în descriere</label>
                        <div class="invalid-feedback">Atenție: Descrierea nu poate să conțină caractere speciale!</div>
                    </div>
                </div>

                <div class="col-md-4 col-sm-6 align-self-center">
                    <label class="form-label fw-bold text-dark" for="inp-pret">
                        Preț maxim: <span id="infoRange" class="text-primary fw-bold">(<%= locals.maxPret %>)</span> RON
                    </label>
                    <input type="range" class="form-range" id="inp-pret" value="<%= locals.maxPret %>" min="<%= locals.minPret %>" max="<%= locals.maxPret %>">
                    <div class="d-flex justify-content-between text-muted small px-1" style="margin-top: -4px;">
                        <span><%= locals.minPret %> RON</span>
                        <span><%= locals.maxPret %> RON</span>
                    </div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold text-dark" for="inp-categorie"><i class="bi bi-tag me-1"></i>Categorie:</label>
                    <select id="inp-categorie" class="form-select">
                        <option value="toate" <%= (locals.tip_activ == 'toate') ? 'selected' : '' %>>Oricare</option>
                        <% for (let opt of locals.optiuni) { %>
                            <option value="<%- opt.unnest %>" <%= (locals.tip_activ == opt.unnest) ? 'selected' : '' %>><%- opt.unnest %></option>
                        <% } %>
                    </select>
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold text-dark" for="inp-luni">
                        <i class="bi bi-calendar-month me-1"></i>Luni adăugare ofertă:
                    </label>
                    <select id="inp-luni" class="form-select" multiple size="3">
                        <% for (let luna of locals.luni) { %>
                            <option value="<%= luna %>" selected><%= luna %></option>
                        <% } %>
                    </select>
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold text-dark" for="inp-varsta">
                        <i class="bi bi-person-badge me-1"></i>Vârstă recomandată:
                    </label>
                    <input type="text" id="inp-varsta" list="lista-varste" class="form-control" placeholder="Alege sau scrie o vârstă">
                    
                    <datalist id="lista-varste">
                        <% for(let v of locals.varste) { %>
                            <option value="<%= v %>"></option>
                        <% } %>
                    </datalist>
                </div>

               <div class="btn-group w-100 container-toggle-radio" role="group" aria-label="Filtru Culoare">
                    <input type="radio" class="btn-check" name="gr_rad" id="i_rad0" value="toate" checked autocomplete="off">
                    <label class="btn btn-outline-primary" for="i_rad0">Orice culoare</label>

                    <% 
                        const claseCulori = {
                            'Albastru': 'btn-outline-info',
                            'Rosu': 'btn-outline-danger',
                            'Verde': 'btn-outline-success',
                            'Multicolor': 'btn-outline-warning text-dark',
                            'Maro': 'btn-outline-brown',
                            'Negru': 'btn-outline-dark'
                        };
                        let i = 1; 
                    %>
                    <% for (let culoare of locals.culori) { %>
                        <input type="radio" class="btn-check" name="gr_rad" id="i_rad<%= i %>" value="<%= culoare %>" autocomplete="off">
                        <label class="btn <%= claseCulori[culoare] || 'btn-outline-secondary' %>" for="i_rad<%= i %>"><%= culoare %></label>
                        <% i++; %>
                    <% } %>
                </div>

                <div class="col-md-6 col-12 mt-2 d-flex align-items-end pb-1">
                    <div class="w-100">
                        <label class="form-label fw-bold text-dark d-block"><i class="bi bi-percent me-1"></i>Oferte speciale:</label>
                        <input type="checkbox" class="btn-check" id="inp-voucher" autocomplete="off">
                        <label class="btn btn-outline-info w-100 text-start fw-bold py-2 text-dark" for="inp-voucher">
                            <i class="bi bi-tags-fill me-2 text-info"></i>Afișează doar cu discount pe baza criteriului de voucher de loialitate
                        </label>
                    </div>
                </div>
            </div>

            <hr class="my-4 border-secondary">

            <div class="row g-2 justify-content-between align-items-center">
                <div class="col-auto d-flex flex-wrap gap-2">
                    <button id="filtrare" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-funnel-fill me-1"></i><span class="d-none d-sm-inline">Filtrează</span>
                    </button> 
                    <button id="resetare" class="btn btn-secondary btn-lg px-4 shadow-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i><span class="d-none d-sm-inline">Resetează</span>
                    </button>
                    <button id="sortAsc" class="btn btn-success btn-lg px-4 shadow-sm">
                        <i class="bi bi-sort-numeric-down me-1"></i><span class="d-none d-sm-inline">Sort Crescător</span>
                    </button>
                    <button id="sortDesc" class="btn btn-danger btn-lg px-4 shadow-sm">
                        <i class="bi bi-sort-numeric-down-alt"></i><span class="d-none d-sm-inline">Sort Descrescător</span>
                    </button>
                </div>
                <div class="col-sm-auto col-12 text-end mt-2 mt-sm-0">
                    <button id="calculeazaPret" class="btn btn-dark btn-lg px-4 shadow-sm w-100-mobile">
                        <i class="bi bi-calculator me-1"></i><span class="d-none d-sm-inline">Calculează suma</span>
                    </button>
                </div>
            </div>
        </section>

        
        <section id="produse">
            <div class="grid-produse">
                <% 
                    //E5B14
                    let minPreturiCategorie = {};
                    for(let p of locals.produse) {
                        let cat = p.categorie_mare;
                        let pret = parseFloat(p.pret);
                        if(minPreturiCategorie[cat] === undefined || pret < minPreturiCategorie[cat]) {
                            minPreturiCategorie[cat] = pret;
                        }
                    }
                %>

                <% for( let prod of locals.produse) { %>
                    <% 
                        let esteCelMaiIeftin = parseFloat(prod.pret) === minPreturiCategorie[prod.categorie_mare]; 
                    %>
                    
                    <article class="produs <%- prod.categorie_mare.replace(/\s+/g, '') %> <%= esteCelMaiIeftin ? 'border-warning' : '' %>" 
                             id="produs_<%- prod.id %>"
                             <%= esteCelMaiIeftin ? 'style=border-width:2px;box-shadow:0_8px_25px_rgba(255,193,7,0.15);' : '' %>>
                        
                        <h3>
                            <a href="/produs/<%-prod.id %>">
                                <span class="val-nume"><%- prod.nume%></span>
                            </a>
                        </h3>
                        
                        <% if (esteCelMaiIeftin) { %>
                            <div class="alert alert-warning text-center fw-bold py-1 px-2 rounded-3 mb-3 shadow-sm border border-warning" 
                                 style="font-size: 0.85rem; background-color: #fff3cd; color: #856404; letter-spacing: 0.5px;">
                                <i class="bi bi-piggy-bank-fill me-1 text-warning fs-6"></i> CEL MAI IEFTIN DIN CATEGORIE!
                            </div>
                        <% } %>
                        
                        <div class="prod-layout">
                           
                            <div class="col-stanga">
                                <a href="/produs/<%-prod.id %>" class="d-block mb-3 text-center layout-img-link">
                                   <img src="<%- prod.imagine %>" alt="[imagine <%- prod.nume %>]" />
                                </a>
                                <p class="text-muted mb-1 small-info">Categorie: <span class="val-categorie fw-bold"><%- prod.categorie_mare %></span></p>
                                <p class="pret-container mb-2 text-success fw-bold">Preț: <span class="val-pret h5 mb-0 fw-bold"><%- prod.pret %></span> RON</p>

                                <button class="btn btn-sm btn-outline-info w-100 fw-bold btn-compara" 
                                     data-id="<%- prod.id %>" 
                                     data-nume="<%- prod.nume %>" 
                                     data-pret="<%- prod.pret %>" 
                                     data-culoare="<%- prod.culoare_dominanta %>" 
                                     data-varsta="<%- prod.varsta_recomandata %>"
                                     data-voucher="<%- prod.admite_voucher %>">
                                     <i class="bi bi-arrow-left-right"></i> Compară
                                </button>
                            </div>

                            <div class="col-dreapta">
                                <details class="border rounded p-2 mb-3 bg-light" open>
                                    <summary class="fw-bold text-primary cursor-pointer">Specificații</summary>
                                    <ul class="list-unstyled mt-2 ms-2 lh-lg text-dark">
                                        <li><b>Culoare dominantă:</b> <i class="val-culoare"><%- prod.culoare_dominanta %></i></li>
                                        <li><b>Componente:</b> <i class="val-componente"><%- prod.componente %></i></li>
                                        <li><b>Durată (min):</b> <i class="val-durata"><%- prod.durata_minute %></i> minute</li>
                                        <li><b>Data adăugării:</b> <i><time class="val-data" datetime="<%- prod.data_adaugare %>"><%- formateazaData(prod.data_adaugare) %></time></i></li>
                                        <li><b>Admite voucher:</b> <i class="val-voucher"><%- prod.admite_voucher %></i></li>
                                        <li><b>Vârstă recomandată:</b> <i class="val-varsta"><%- prod.varsta_recomandata %></i></li>
                                    </ul>
                                </details>
                                <p class="val-descriere text-secondary small italic"><%- prod.descriere%></p>
                            </div>
                        </div>
                    </article>
                <% } %>
            </div>
        </section>

    </main>

    <%- include("../fragmente/footer") %>
</body>
</html>