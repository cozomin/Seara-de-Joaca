<!DOCTYPE html>
<html lang="ro">
<head>
    <meta name="description" content="Află mai multe detalii despre <%- locals.prod.nume %> la magazinul Seara de Joacă.">
    <meta name="keywords" content="<%- locals.prod.nume %>, <%- locals.prod.categorie_mare %>, jocuri, magazin">
    <title>Seara de Joacă - <%- locals.prod.nume %></title>
    <%- include("../fragmente/head") %>    
    <link rel="stylesheet" href="/resurse/css/nav.css" type="text/css" />
    <link rel="stylesheet" href="/resurse/css/general.css" type="text/css" />
    <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
</head>
<body>
    <%- include("../fragmente/header") %>

    <main>
        <section>
            <h2>Detalii Produs</h2>
            <article id="art-produs">
                <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                <figure class="imag-produs">
                    <img src="<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" />
                </figure> 
                
                <p><b>Preț:</b> <span class="pret"><%- locals.prod.pret %> RON</span></p>
                <p><b>Descriere:</b> <span class="descriere"><%- locals.prod.descriere %></span></p>
                <p><b>Componente incluse:</b> <span><%- locals.prod.componente %></span></p>
                <p><b>Categorie:</b> <span><%- locals.prod.categorie_mare %></span></p>
                <p><b>Vârsta recomandată:</b> <span><%- locals.prod.varsta_recomandata %></span></p>
                <p><b>Culoare dominantă:</b> <span><%- locals.prod.culoare_dominanta %></span></p>
                <p><b>Durată medie (min):</b> <span><%- locals.prod.durata_minute %> minute</span></p>
                <p><b>Admite utilizare voucher fidelitate:</b> <span><%- locals.prod.admite_voucher ? "Da" : "Nu" %></span></p>
                   
            </article>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
</body>
</html>